// $$__EasyFMBootstrapTokens

globals {
    $$__EasyFMBootstrapTokens
}

script __EasyFM_WebViewerCallback_Internal ($param: string) {
    let $token = `JSONGetElement($param ; "token")`
    let $protocol = `JSONGetElement($param ; "protocol")`
    let $bootstrapConfig = `JSONGetElement($$__EasyFMBootstrapTokens; $token)`
    let $allowedURLs = ```JSONSetElement( "{}" ;
        ["https://example.com/page" ; True ; JSONBoolean]
    )```

    if `IsEmpty($bootstrapConfig)` {
        throw "Bootstrap config is either invalid, or already consumed"
    }

    if `$protocol != "easy-fm.webviewer/v1"` {
        throw "Unsupported EasyFM webviewer protocol"
    }

    let $callbackName = `JSONGetElement($bootstrapConfig ; "callbackName")`
    let $webViewerName = `JSONGetElement($param ; "webViewerName")`

    // Verify origins for all requests
    let $url = ```GetValue(
        Substitute(GetLayoutObjectAttribute($webViewerName ; "source") ; "?" ; "\r") ;
        1
    )```
    if `IsEmpty(JSONGetElement($allowedURLs ; $url)) or not JSONGetElement($allowedURLs ; $url)` {
        throw "Bootstrap config is either invalid, or already consumed"
    }

    if `JSONGetElement($param ; "action") = "connect"` {
        if ```
        not IsEmpty($callbackName)
        or JSONGetElement($param ; "webViewerName") != JSONGetElement($bootstrapConfig ; "webViewerName")
        or JSONGetElement($param ; "window") != JSONGetElement($bootstrapConfig ; "window")
        or JSONGetElement($param ; "recordNumber") != JSONGetElement($bootstrapConfig ; "recordNumber")
        ``` {
            throw "Bootstrap config is either invalid, or already consumed"
        }

        // Now that we've verified this is a valid bootstrap, let's save the callbackName and respond
        let $$__EasyFMBootstrapTokens = ```JSONSetElement($$__EasyFMBootstrapTokens ;
            $token & ".callbackName" ; JSONGetElement($param ; "callbackName")
        )```

        return "null"
    }

    // Authenticate the connection
    if ```
    IsEmpty($callbackName)
    or JSONGetElement($param ; "webViewerName") != JSONGetElement($bootstrapConfig ; "webViewerName")
    or JSONGetElement($param ; "window") != JSONGetElement($bootstrapConfig ; "window")
    or JSONGetElement($param ; "recordNumber") != JSONGetElement($bootstrapConfig ; "recordNumber")
    ``` {
        throw "Unauthenticated"
    }


    let $res, $err = executeFileMakerDataAPI({
        request: `JSONGetElement($param;"request")`
    })
    return $res
}