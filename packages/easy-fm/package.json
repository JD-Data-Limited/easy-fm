{
    "name": "@jd-data-limited/easy-fm",
    "version": "5.0.0-beta.8",
    "dependencies": {
        "chalk": "^5.6.2",
        "commander": "^15.0.0",
        "inquirer": "^14.2.2",
        "temporal-polyfill": "^1.0.5",
        "zod": "^4.6.5"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./typegen": {
            "types": "./dist/typegen/index.d.ts",
            "import": "./dist/typegen/index.js"
        }
    },
    "module": "es2022",
    "homepage": "https://jd-data.com/project/easyfm/",
    "url": "https://github.com/JD-Data-Limited/easy-fm",
    "license": "SEE LICENSE IN LICENSE",
    "description": "easy-fm is a Node.js module that allows you to interact with\r a [FileMaker database stored](https://www.claris.com/filemaker/) on\r a [FileMaker server](https://www.claris.com/filemaker/server/). This module interacts with your server using the\r [FileMaker Data API](https://help.claris.com/en/data-api-guide/content/index.html).",
    "files": [
        "./dist/**/*"
    ],
    "scripts": {
        "build": "tsc",
        "test": "npm run build && jest",
        "test:types": "tsc --project tsconfig.test.json",
        "test:coverage": "jest --coverage --testPathIgnorePatterns='/__tests__/database.test.ts$'",
        "test:integration": "npm run build && jest __tests__/database.test.ts --runInBand",
        "test:unit": "jest __tests__/query.test.ts __tests__/CookieJar.test.ts --runInBand",
        "test:runtime": "pnpm build && pnpm test:runtime:bun && pnpm test:runtime:deno && pnpm test:runtime:workers",
        "test:runtime:bun": "bun test ./runtime-tests/bun.test.ts",
        "test:runtime:deno": "deno test --no-check --allow-read --node-modules-dir=manual ./runtime-tests/deno.test.ts",
        "test:runtime:workers": "vitest run --config ./runtime-tests/workers/vitest.config.ts",
        "stress:search": "tsx src/bin/stressSearch.ts",
        "docs:build": "typedoc --options ../../docs/theme.json",
        "lint": "prettier --write . && eslint ./src --fix"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JD-Data-Limited/easy-fm.git"
    },
    "keywords": [
        "FileMaker",
        "filemaker",
        "fms",
        "data api",
        "Data",
        "API",
        "REST",
        "fmdapi",
        "simplicity",
        "business"
    ],
    "author": "JD-Data Limited",
    "bugs": {
        "url": "https://github.com/JD-Data-Limited/easy-fm/issues"
    },
    "engines": {
        "node": ">=22.22.3"
    },
    "devDependencies": {
        "@babel/cli": "^8.0.6",
        "@babel/core": "^8.0.6",
        "@babel/preset-env": "^8.0.6",
        "@babel/preset-typescript": "^8.0.1",
        "@cloudflare/vitest-plugin": "^1.2.2",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/btoa": "^1.2.5",
        "@types/events": "^3.0.3",
        "@types/inquirer": "^9.0.10",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.2",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "babel-jest": "^30.5.2",
        "dotenv": "^18.0.2",
        "eslint": "^10.11.0",
        "eslint-config-standard-with-typescript": "^43.0.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-n": "^18.3.0",
        "eslint-plugin-promise": "^7.3.0",
        "globals": "^17.12.0",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.12",
        "ts-morph": "^28.0.0",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^4.1.11"
    },
    "bin": {
        "easyfm": "dist/bin/cli.js"
    },
    "publishConfig": {
        "access": "public"
    }
}
